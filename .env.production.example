# ==========================================
# Database Configuration
# ==========================================
DB_PASSWORD=your-secure-db-password

# ==========================================
# Security / Auth
# ==========================================
JWT_SECRET=generate-a-64-character-random-hex-string-for-production
JWT_EXPIRES_IN=7d

# ==========================================
# Application URL
# ==========================================
# Set to your EC2 public IP (e.g. http://13.233.xx.xx) or your domain (e.g. https://yourdomain.com)
FRONTEND_URL=http://your-ec2-public-ip

# ==========================================
# AWS S3 Storage (New Account Configuration)
# ==========================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-new-s3-bucket-name

# Authentication for S3:
# RECOMMENDED (Option A): Leave both empty if you attached an IAM Role to your EC2 instance!
# OPTION B: Fill in IAM User credentials below only if not using an IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
